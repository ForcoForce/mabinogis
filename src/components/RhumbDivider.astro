---
interface Props {
  flip?: boolean;
}
const { flip = false } = Astro.props;
---
<div class:list={["rhumb", { "rhumb--flip": flip }]} aria-hidden="true">
  <svg viewBox="0 0 600 40" preserveAspectRatio="none" focusable="false">
    <line x1="0" y1="20" x2="600" y2="20" />
    <line x1="300" y1="20" x2="0" y2="4" />
    <line x1="300" y1="20" x2="0" y2="12" />
    <line x1="300" y1="20" x2="0" y2="28" />
    <line x1="300" y1="20" x2="0" y2="36" />
    <line x1="300" y1="20" x2="600" y2="4" />
    <line x1="300" y1="20" x2="600" y2="12" />
    <line x1="300" y1="20" x2="600" y2="28" />
    <line x1="300" y1="20" x2="600" y2="36" />
  </svg>
  <span class="rhumb__dot"></span>
</div>

<style>
  .rhumb {
    position: relative;
    width: min(100% - 2rem, var(--content-max));
    height: 40px;
    margin-inline: auto;
  }
  .rhumb--flip {
    transform: scaleY(-1);
  }
  svg {
    width: 100%;
    height: 100%;
  }
  line {
    stroke: var(--taupe);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .rhumb__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    background: var(--vermilion);
    transform: translate(-50%, -50%) rotate(45deg);
  }
</style>
