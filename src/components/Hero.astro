---
import { Image } from "astro:assets";
import bgBlur from "@/assets/backgrounds/bg-1-blur.webp";
import bgSharp from "@/assets/backgrounds/bg-1-original.webp";
import Logo from "@/components/Logo.astro";
import Stamp from "@/components/Stamp.astro";
import Graticule from "@/components/Graticule.astro";
import { site } from "@/data/site";
---
<section class="hero">
  <div class="hero__bg">
    <Image src={bgSharp} alt="" loading="eager" />
    <div class="hero__blur">
      <Image src={bgBlur} alt="" loading="eager" />
    </div>
  </div>
  <div class="hero__vignette"></div>

  <div class="hero__content">
    <div class="hero__logo">
      <Logo size="min(26vh, 230px)" />
    </div>
    <h1 class="hero__title">{site.name}</h1>

    <div class="card card--frost hero__card">
      <Graticule />
      <p class="hero__tagline">{site.tagline}</p>
      <p class="hero__sub">Map design · GIS analysis · Geospatial databases</p>
      <span class="hero__stamp"><Stamp text="Open for projects" /></span>
    </div>

    <a class="hero__cue" href="#pillars">
      <span>Scroll</span>
      <span class="hero__arrow" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero {
    /* Tuning knobs */
    --blur-full-until: 20%;   /* blur at full strength inside this radius */
    --blur-gone-at: 70%;      /* blur fully faded out (sharp map) at this radius */
    --glow-opacity: 0.59;     /* strength of the soft glow behind the logo */
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: var(--paper);
  }
  @media (max-width: 899px) {
    .hero {
      min-height: calc(100svh - 56px);
    }
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    opacity: var(--hero-bg-opacity);
    /* --parallax is set by the script at the bottom of this file */
    transform: translate3d(0, var(--parallax, 0px), 0) scale(1.08);
    will-change: transform;
  }
  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Blurred copy on top; masked so it is strongest in the centre and fades to the sharp map at the edges */
  .hero__blur {
    position: absolute;
    inset: 0;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 var(--blur-full-until), transparent var(--blur-gone-at));
    mask-image: radial-gradient(ellipse at center, #000 var(--blur-full-until), transparent var(--blur-gone-at));
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, transparent 70%, var(--paper) 100%),
      radial-gradient(ellipse at center, transparent 60%, color-mix(in srgb, var(--paper) 45%, transparent) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-3) 6.5rem;
    text-align: center;
  }

  .hero__logo {
    position: relative;
    isolation: isolate;
  }
  .hero__logo::before {
    content: "";
    position: absolute;
    inset: -45%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle closest-side, var(--card) 0%, var(--card) 40%, transparent 100%);
    opacity: var(--glow-opacity);
    pointer-events: none;
  }

  .hero__title {
    margin: 0;
  }

  .hero__card {
    padding: var(--sp-4) var(--sp-5);
    max-width: 34rem;
  }
  .hero__tagline {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-head);
    font-size: var(--fs-4);
    line-height: 1.1;
  }
  .hero__sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-0);
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .hero__stamp {
    position: absolute;
    top: -16px;
    right: -14px;
  }
  @media (max-width: 899px) {
    .hero__stamp {
      right: -4px;
    }
  }

  .hero__cue {
    position: absolute;
    bottom: var(--sp-4);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-0);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .hero__cue:hover {
    color: var(--vermilion);
  }
  .hero__arrow {
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
</style>

<script>
  // Parallax: the background drifts down while you scroll, so it moves slower than the page.
  const SPEED = 0.4; // 0 = moves with the page, 1 = stays fixed on screen
  const hero = document.querySelector<HTMLElement>(".hero");
  const background = document.querySelector<HTMLElement>(".hero__bg");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && background) {
    let queued = false;

    const update = () => {
      queued = false;
      if (reducedMotion.matches) {
        background.style.removeProperty("--parallax");
        return;
      }
      const scrolled = Math.min(Math.max(0, -hero.getBoundingClientRect().top), hero.offsetHeight);
      background.style.setProperty("--parallax", `${Math.round(scrolled * SPEED)}px`);
    };

    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    reducedMotion.addEventListener("change", update);
    update();
  }
</script>
