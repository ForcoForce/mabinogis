<style>
  .logo svg { width: 100%; height: auto; display: block; overflow: visible; }
  .cls-1 { font-size: 40.5px; font-family: "Baskervville", "Baskerville Old Face", Baskerville, Georgia, serif; }
  .cls-1, .cls-4 { fill: var(--taupe, #aa9585); }
  .cls-2 { fill: none; stroke: var(--taupe, #aa9585); stroke-miterlimit: 10; stroke-width: 1.82px; }
  .cls-3 { fill: var(--cream-deep, #e5dfd1); }
  .cls-5 { fill: var(--vermilion, #bf4c2c); }

  #Inner_Rings, #Arrow { transform-box: fill-box; transform-origin: center center; }
  .logo--animate #Inner_Rings { animation: spinCW 22s linear infinite; }
  .logo--animate #Arrow { animation: needleIdle 1.6s ease-in-out infinite; }

  @keyframes spinCW { to { transform: rotate(360deg); } }
  @keyframes needleIdle {
    0%{transform:rotate(0)} 10%{transform:rotate(4.8deg)} 22%{transform:rotate(1.3deg)}
    35%{transform:rotate(-6.5deg)} 47%{transform:rotate(-2deg)} 58%{transform:rotate(5.9deg)}
    68%{transform:rotate(2.7deg)} 78%{transform:rotate(-5.1deg)} 88%{transform:rotate(-1.4deg)}
    95%{transform:rotate(1.8deg)} 100%{transform:rotate(0)}
  }
  @media (prefers-reduced-motion: reduce) {
    .logo--animate #Inner_Rings, .logo--animate #Arrow { animation: none; }
  }
</style>
