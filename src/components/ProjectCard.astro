---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Stamp from "@/components/Stamp.astro";
import Graticule from "@/components/Graticule.astro";
import "@/styles/media.css";

interface Props {
  title: string;
  summary: string;
  cover: ImageMetadata;
  tags: string[];
  year: number;
  href: string;
}
const { title, summary, cover, tags, year, href } = Astro.props;
---
<article class="card card--tilt project" data-tags={tags.join(",")}>
  <a class="project__link" href={href}>
    <div class="project__media">
      <Image src={cover} alt={`${title} cover image`} width={800} />
      <span class="project__stamp"><Stamp text={String(year)} tone="ink" tilt={4} /></span>
    </div>
    <h3 class="project__title">{title}</h3>
    <p class="project__summary">{summary}</p>
    {tags.length > 0 && (
      <ul class="project__tags">
        {tags.map((tag) => <li class="chip">{tag}</li>)}
      </ul>
    )}
  </a>
  <Graticule />
</article>

<style>
  .project__link {
    display: block;
    padding: 14px 14px var(--sp-3);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
  }
  .project__media {
    position: relative;
    margin-bottom: var(--sp-3);
  }
  /* the image keeps its own proportions: nothing is cropped */
  .project__media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .project__stamp {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
  }
  .project__title {
    margin-bottom: var(--sp-2);
    padding-inline: var(--sp-1);
  }
  .project__summary {
    margin: 0 0 var(--sp-3);
    padding-inline: var(--sp-1);
    color: var(--ink-soft);
  }
  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    padding-inline: var(--sp-1);
  }
</style>

<script>
  // Staggered ("masonry") layout that keeps the reading order: each card goes into the shortest column,
  // left to right, so the newest projects are at the top. Without JavaScript the CSS columns are used.
  const MIN_COLUMN = 270;

  function layout(box: HTMLElement) {
    // only the cards: Astro may place a <script> tag inside this box, which must not take a column slot
    const items = Array.from(box.querySelectorAll<HTMLElement>(":scope > .card")).filter((el) => !el.hidden);
    const gap = parseFloat(getComputedStyle(box).columnGap) || 24;
    const columns = Math.max(1, Math.floor((box.clientWidth + gap) / (MIN_COLUMN + gap)));
    const width = (box.clientWidth - gap * (columns - 1)) / columns;
    items.forEach((el) => (el.style.width = `${width}px`)); // set the width first, so the heights are measured correctly
    const heights = new Array<number>(columns).fill(0);
    for (const el of items) {
      const col = heights.indexOf(Math.min(...heights));
      el.style.left = `${col * (width + gap)}px`;
      el.style.top = `${heights[col]}px`;
      heights[col] += el.offsetHeight + gap;
    }
    box.style.height = `${Math.max(0, ...heights) - (items.length ? gap : 0)}px`;
  }

  document.querySelectorAll<HTMLElement>(".masonry").forEach((box) => {
    box.classList.add("masonry--js");
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; layout(box); });
    };
    new ResizeObserver(schedule).observe(box);                                    // window and sidebar size changes
    new MutationObserver(schedule).observe(box, { attributes: true, attributeFilter: ["hidden"], subtree: true }); // tag filter
    box.querySelectorAll("img").forEach((img) => img.addEventListener("load", schedule));
    document.fonts?.ready.then(schedule);
    schedule();
  });
</script>
