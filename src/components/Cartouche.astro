---
import { site } from "@/data/site";

const year = new Date().getFullYear();
---
<div class="cartouche">
  <p class="cartouche__name">{site.name}</p>
  <dl class="cartouche__rows">
    <div><dt>By</dt><dd>{site.owner}</dd></div>
    <div><dt>Position</dt><dd>{site.coord}</dd></div>
    <div><dt>Sheet</dt><dd>1 of 1</dd></div>
    <div><dt>Year</dt><dd>{year}</dd></div>
  </dl>
</div>

<style>
  .cartouche {
    display: inline-block;
    min-width: 280px;
    padding: var(--sp-3);
    border: 3px double var(--ink);
    background: var(--card);
    color: var(--ink);
  }
  .cartouche__name {
    margin: 0 0 var(--sp-2);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-head);
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .cartouche__rows {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-0);
  }
  .cartouche__rows div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-block: 2px;
  }
  dt {
    color: var(--ink-soft);
    white-space: nowrap;
  }
  dd {
    margin: 0;
    text-align: right;
  }
</style>
