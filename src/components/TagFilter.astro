---
interface Props {
  tags: string[];
  targetId: string;
}
const { tags, targetId } = Astro.props;
---
<div class="tagfilter" data-target={targetId} role="group" aria-label="Filter by tag">
  <button type="button" class="tagfilter__btn" data-filter="all" aria-pressed="true">All</button>
  {tags.map((tag) => (
    <button type="button" class="tagfilter__btn" data-filter={tag} aria-pressed="false">{tag}</button>
  ))}
  <p class="sr-only" role="status" data-status></p>
</div>

<style>
  .tagfilter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-5);
  }
  .tagfilter__btn {
    font-family: var(--font-mono);
    font-size: var(--fs-0);
    letter-spacing: 0.06em;
    padding: 0.4rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .tagfilter__btn:hover {
    background: var(--cream-deep);
  }
  .tagfilter__btn[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--card);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".tagfilter").forEach((root) => {
    const target = document.getElementById(root.dataset.target ?? "");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-filter]");
    if (!target) return;

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "all";
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));

        let shown = 0;
        target.querySelectorAll<HTMLElement>("[data-tags]").forEach((item) => {
          const itemTags = (item.dataset.tags ?? "").split(",");
          const visible = filter === "all" || itemTags.includes(filter);
          item.hidden = !visible;
          if (visible) shown += 1;
        });

        if (status) status.textContent = `Showing ${shown} ${shown === 1 ? "project" : "projects"}`;
      });
    });
  });
</script>
