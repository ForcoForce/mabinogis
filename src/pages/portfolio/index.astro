---
import { getCollection } from "astro:content";
import BaseLayout from "@/components/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TagFilter from "@/components/TagFilter.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const projects = (await getCollection("portfolio", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year
);
const tags = [...new Set(projects.flatMap((entry) => entry.data.tags))].sort();
---
<BaseLayout title="Portfolio" description="Selected maps, spatial analyses and geospatial database projects.">
  <section class="section container">
    <SectionHeader
      tag="Portfolio"
      title="Maps, analyses and databases"
      lead="Pick a tag to filter the projects."
    />

    {projects.length === 0 ? (
      <p>No projects yet. Check back soon.</p>
    ) : (
      <>
        <TagFilter tags={tags} targetId="project-grid" />
        <div class="masonry" id="project-grid">
          {projects.map((entry) => (
            <ProjectCard
              title={entry.data.title}
              summary={entry.data.summary}
              cover={entry.data.cover}
              tags={entry.data.tags}
              year={entry.data.year}
              href={`/portfolio/${entry.id}`}
            />
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
