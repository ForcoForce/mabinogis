---
import { getCollection } from "astro:content";
import BaseLayout from "@/components/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import PillarCard from "@/components/PillarCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PostCard from "@/components/PostCard.astro";
import CTABand from "@/components/CTABand.astro";
import RhumbDivider from "@/components/RhumbDivider.astro";
import SoundingsBackground from "@/components/SoundingsBackground.astro";
import { services } from "@/data/services";

const projects = (await getCollection("portfolio", ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year)
  .slice(0, 3);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---
<BaseLayout title="Mabinogis · Maps are cool.">
  <Hero />

  <section id="pillars" class="section pillars">
    <SoundingsBackground />
    <div class="container pillars__inner">
      <SectionHeader
        tag="Services"
        title="Four ways to put your data on the map"
        lead="Whether it needs to look good, hold up under analysis, or live in a tidy database."
      />
      <div class="pillars__grid">
        {services.map((service) => <PillarCard service={service} />)}
      </div>
    </div>
  </section>

  <RhumbDivider />

  <section id="work" class="section">
    <div class="container">
      <SectionHeader
        tag="Selected work"
        title="Recent projects"
        lead="A few maps and datasets I quite like the look of."
      />
      <div class="grid">
        {projects.map((entry) => (
          <ProjectCard
            title={entry.data.title}
            summary={entry.data.summary}
            cover={entry.data.cover}
            tags={entry.data.tags}
            year={entry.data.year}
            href={`/portfolio/${entry.id}`}
          />
        ))}
      </div>
      <p class="more"><a class="btn btn--ghost" href="/portfolio">See all projects</a></p>
    </div>
  </section>

  <RhumbDivider flip />

  <section id="blog" class="section">
    <div class="container">
      <SectionHeader
        tag="From the blog"
        title="Field notes"
        lead="The more interesting projects, and what I learned making them."
      />
      <div class="grid">
        {posts.map((entry) => (
          <PostCard
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            tags={entry.data.tags}
            href={`/blog/${entry.id}`}
          />
        ))}
      </div>
      <p class="more"><a class="btn btn--ghost" href="/blog">Read the blog</a></p>
    </div>
  </section>

  <CTABand
    heading="Got a map problem?"
    text="Tell me what you're working on and let's make it look (and work) great."
    label="Say hello"
    href="/contact"
  />
</BaseLayout>

<style>
  .pillars {
    overflow: hidden;
    background: var(--paper);
  }
  .pillars__inner {
    position: relative;
  }
  .pillars__grid {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1500px) {
    .pillars__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .more {
    margin: var(--sp-5) 0 0;
    text-align: center;
  }
</style>
